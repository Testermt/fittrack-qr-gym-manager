rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Zero-trust admin check used by every OTHER collection's rules below.
    // NOTE: exists()/get() calls made from *inside* a rule evaluate against
    // the target document's data but do not need `allow read` on that
    // target path themselves (that's how Firestore rules avoid circular
    // permission checks). So this works even though /admins/{email} below
    // has no public read access — do not "fix" that by loosening the
    // admins read rule, it isn't broken.
       function isVerifiedAdminDirect() {
      return request.auth != null 
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Role-based access on top of the admin check above. `role` lives on
    // the same admins/{email} doc (set manually via Firebase Console /
    // Admin SDK, same as the whitelist itself — there's no in-app admin
    // management UI). Missing/absent `role` defaults to 'owner' so an
    // existing admin who predates this field isn't accidentally locked out.
    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.get('role', 'owner');
    }
    // Full access: owner (the gym's operator/manager). Front-desk staff
    // (role == 'staff') gets everything isVerifiedAdminDirect() alone would
    // allow EXCEPT the operations explicitly gated behind this function below
    // (member create/delete, mark-paid & other member field writes beyond
    // approve, refunds, payments, and pricing/settings changes).
    function isOwnerAdmin() {
      return isVerifiedAdminDirect() && adminRole() == 'owner';
    }


    // Members collection: Public read for status, secure write/update
    match /members/{phone} {
      // Shared shape/field checks used by both the public self-registration
      // path and the admin manual-registration path below.
      function hasValidMemberShape() {
        return phone.matches('^[0-9]{7,15}$')
              && request.resource.data.keys().hasOnly(
                   ['name','phone','address','joinDate','plan','expiryDate',
                    'paymentStatus','approved','createdAt','updatedAt',
                    'whatsappBotOptIn','whatsappMarketingOptIn'])
              && request.resource.data.phone == phone
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() < 100
              && request.resource.data.address is string
              // Any of the original 4 built-in IDs is always valid (back-
              // compat / safety net if gymConfig hasn't been written yet),
              // OR the plan ID currently exists in settings/gymConfig.plans
              // — this is what lets an admin-added plan (5th, 6th... plan,
              // including day-based ones) actually be usable to register a
              // member instead of being silently rejected here.
              && (
                   request.resource.data.plan in ['1m','3m','6m','12m']
                   || (
                        exists(/databases/$(database)/documents/settings/gymConfig)
                        && request.resource.data.plan in
                             get(/databases/$(database)/documents/settings/gymConfig).data.plans.keys()
                      )
                 )
              && request.resource.data.joinDate is string
              && request.resource.data.expiryDate is string
              && (!('whatsappBotOptIn' in request.resource.data) || request.resource.data.whatsappBotOptIn is bool)
              && (!('whatsappMarketingOptIn' in request.resource.data) || request.resource.data.whatsappMarketingOptIn is bool);
      }

      allow create: if
        // Public self-registration: always starts unapproved & unpaid —
        // this branch is unchanged from before.
        (hasValidMemberShape()
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.approved == false)
        ||
        // Admin manual registration: owner-only — it can create a member
        // pre-approved and/or already marked paid, both of which skip the
        // front-desk's normal Approve step, so staff can't use this branch.
        (isOwnerAdmin()
          && hasValidMemberShape()
          && request.resource.data.paymentStatus in ['pending', 'paid']
          && request.resource.data.approved == true);

      allow get: if true;
      allow list: if isVerifiedAdminDirect();
      // Deleting a member record is owner-only.
      allow delete: if isOwnerAdmin();

      // Update: owners can change anything. Staff get a narrow carve-out to
      // flip ONLY `approved` from false → true (the Approve button) — every
      // other field (paymentStatus, plan, expiryDate, dues, freeze state,
      // phone…) requires isOwnerAdmin(). The public self-checkin kiosk
      // (member.js, no auth) separately gets its own narrow carve-out to
      // bump its OWN doc's monthly check-in counter after a successful
      // checkin — a harmless display stat, not a trust boundary.
      allow update: if isOwnerAdmin()
        ||
        (isVerifiedAdminDirect()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'updatedAt'])
          && resource.data.approved == false
          && request.resource.data.approved == true)
        ||
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['monthlyCheckinCount', 'checkinMonthKey'])
          && request.resource.data.monthlyCheckinCount is int
          && request.resource.data.monthlyCheckinCount >= 0
          && request.resource.data.checkinMonthKey is string);
    }

    // Checkins collection: Prevent fake check-ins from unapproved members.
    // `get` is public (same pattern as members/{phone} below) because
    // members aren't signed in — the kiosk app needs to fetch a specific
    // check-in doc by its deterministic ID (`${memberId}_${dateKey}`) to
    // show "already checked in today" and the last-7-days history, and
    // there's no auth session to scope a broader query to. `list` stays
    // admin-only so nobody can enumerate every check-in (and thus every
    // memberId) across the whole gym.
    match /checkins/{checkinId} {
  allow create: if request.resource.data.memberId is string
                && request.resource.data.phone is string
                && request.resource.data.phone.size() >= 7
                && request.resource.data.dateKey is string
                && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') //  Yeh format check add karein
                && request.resource.data.method in ["geofenced-gps", "manual"]
                && request.resource.data.timestamp == request.time
                && checkinId == request.resource.data.memberId + '_' + request.resource.data.dateKey
                && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.approved == true
                // Frozen/paused members can't check in until an admin resumes
                // their membership (see admin.js executeFreezeMember/Resume).
                && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get('isFrozen', false) != true;
                
  allow get: if true;
  allow list: if isVerifiedAdminDirect();
  allow update, delete: if isVerifiedAdminDirect();
}

    
    // Payments collection: financial records — owner-only end to end so
    // front-desk staff can't see payment history.
    match /payments/{paymentId} {
      allow create, read, update, delete: if isOwnerAdmin();
    }

    // Refunds collection: same trust boundary as payments — every
    // mid-plan-cancellation refund is logged here for accountability.
    // Owner-only end to end, same as payments above.
    match /refunds/{refundId} {
      allow create, read, update, delete: if isOwnerAdmin();
    }

    // Settings collection: Public read (UPI config, gym config/plans),
    // admin-only write. `gymConfig` gets an extra shape check purely for
    // data-integrity — every page's plan picker and pricing display reads
    // this doc, so a malformed write (already gated to admins-only; this
    // isn't a new trust boundary) shouldn't be able to break the app for
    // every member at once.
        // Settings collection rules update:
    match /settings/{docId} {
      function isValidGymConfig() {
        return request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.defaultCountryCode is string
              && request.resource.data.plans is map
              && request.resource.data.plans.size() > 0;
      }

      // Feature-tier doc (Basic/Prime/Advance) — controls which optional
      // modules (WhatsApp bot, future features) are unlocked for this gym.
      function isValidTierConfig() {
        return request.resource.data.current in ['basic', 'prime', 'advance'];
      }

      allow get: if true;
      allow list: if isVerifiedAdminDirect();
      // Changing gym config / pricing / tier is owner-only — staff can
      // still read it (needed to render the dashboard), just not edit it.
      allow create, update: if isOwnerAdmin()
                            && (docId != 'gymConfig' || isValidGymConfig())
                            && (docId != 'tier' || isValidTierConfig());
      allow delete: if isOwnerAdmin();
    }


    // Admins collection: Strictly locked down.
    // A signed-in user may read ONLY their own doc ID (needed by the
    // client's direct isVerifiedAdmin() lookup in admin.js). Nobody, not
    // even an authenticated admin, can list the whole collection, and no
    // client write is ever allowed — the whitelist is managed exclusively
    // from the Firebase Console / Admin SDK.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow list: if false;
      allow write: if false;
    }
  }
}
