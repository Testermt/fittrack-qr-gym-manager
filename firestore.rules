rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Zero-trust admin check used by every OTHER collection's rules below.
    // NOTE: exists()/get() calls made from *inside* a rule evaluate against
    // the target document's data but do not need `allow read` on that
    // target path themselves (that's how Firestore rules avoid circular
    // permission checks). So this works even though /admins/{email} below
    // has no public read access — do not "fix" that by loosening the
    // admins read rule, it isn't broken.
       function isVerifiedAdminDirect() {
      return request.auth != null 
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Role-based access on top of the admin check above. `role` lives on
    // the same admins/{email} doc (set manually via Firebase Console /
    // Admin SDK, same as the whitelist itself — there's no in-app admin
    // management UI). Missing/absent `role` defaults to 'owner' so an
    // existing admin who predates this field isn't accidentally locked out.
    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.get('role', 'owner');
    }
    // Full access: owner (the gym's operator/manager). Front-desk staff
    // (role == 'staff') gets everything isVerifiedAdminDirect() alone would
    // allow EXCEPT the operations explicitly gated behind this function below
    // (member create/delete, mark-paid & other member field writes beyond
    // approve, refunds, payments, and pricing/settings changes).
    function isOwnerAdmin() {
      return isVerifiedAdminDirect() && adminRole() == 'owner';
    }

    // Granular staff permissions — lives on the same admins/{email} doc as
    // `role`, as a `permissions` map (see isValidPermissionsMap() below for
    // the full set of keys). Owner is implicitly "all permissions"
    // regardless of this map (see hasPerm()) — the map only ever matters
    // for role == 'staff'. Missing/absent `permissions` defaults to {}
    // (nothing granted), so a staff doc created before this feature
    // existed is locked down, not accidentally opened up.
    function adminPermissions() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.get('permissions', {});
    }
    // True for an owner (always), or for a signed-in staff admin whose
    // `permissions` map has `key` explicitly set to true. This is what lets
    // an owner delegate individual capabilities (add members, edit member
    // details, payments, refunds, delete members, gym settings) to specific
    // staff logins from the in-app Staff Access → Edit Permissions modal,
    // instead of every staff account being all-or-nothing.
    function hasPerm(key) {
      return isVerifiedAdminDirect()
        && (adminRole() == 'owner' || adminPermissions().get(key, false) == true);
    }
    // The only valid shape for a `permissions` map — kept in sync with the
    // checkboxes in admin.js's Staff Access → Edit Permissions UI.
    function isValidPermissionsMap(p) {
      return p.keys().hasOnly(
               ['addMembers','editMemberDetails','payments','refunds',
                'deleteMembers','manageSettings','whatsappBroadcast'])
          && p.keys().hasAll(
               ['addMembers','editMemberDetails','payments','refunds',
                'deleteMembers','manageSettings','whatsappBroadcast'])
          && p.addMembers is bool && p.editMemberDetails is bool
          && p.payments is bool && p.refunds is bool
          && p.deleteMembers is bool && p.manageSettings is bool
          && p.whatsappBroadcast is bool;
    }


    // Members collection: Public read for status, secure write/update
    match /members/{phone} {
      // Shared shape/field checks used by both the public self-registration
      // path and the admin manual-registration path below.
      function hasValidMemberShape() {
        return phone.matches('^[0-9]{7,15}$')
              && request.resource.data.keys().hasOnly(
                   ['name','phone','address','joinDate','plan','expiryDate',
                    'paymentStatus','approved','createdAt','updatedAt',
                    'whatsappBotOptIn','whatsappMarketingOptIn'])
              && request.resource.data.phone == phone
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() < 100
              && request.resource.data.address is string
              // Any of the original 4 built-in IDs is always valid (back-
              // compat / safety net if gymConfig hasn't been written yet),
              // OR the plan ID currently exists in settings/gymConfig.plans
              // — this is what lets an admin-added plan (5th, 6th... plan,
              // including day-based ones) actually be usable to register a
              // member instead of being silently rejected here.
              && (
                   request.resource.data.plan in ['1m','3m','6m','12m']
                   || (
                        exists(/databases/$(database)/documents/settings/gymConfig)
                        && request.resource.data.plan in
                             get(/databases/$(database)/documents/settings/gymConfig).data.plans.keys()
                      )
                 )
              && request.resource.data.joinDate is string
              && request.resource.data.expiryDate is string
              && (!('whatsappBotOptIn' in request.resource.data) || request.resource.data.whatsappBotOptIn is bool)
              && (!('whatsappMarketingOptIn' in request.resource.data) || request.resource.data.whatsappMarketingOptIn is bool);
      }

      allow create: if
        // Public self-registration: always starts unapproved & unpaid —
        // this branch is unchanged from before.
        (hasValidMemberShape()
          && request.resource.data.paymentStatus == "pending"
          && request.resource.data.approved == false)
        ||
        // Admin manual registration: owner, or staff granted the
        // `addMembers` permission — it can create a member pre-approved
        // and/or already marked paid, both of which skip the front-desk's
        // normal Approve step, so a staff account without this permission
        // can't use this branch.
        (hasPerm('addMembers')
          && hasValidMemberShape()
          && request.resource.data.paymentStatus in ['pending', 'paid']
          && request.resource.data.approved == true);

      allow get: if true;
      allow list: if isVerifiedAdminDirect();
      // Deleting a member record: owner, or staff granted `deleteMembers`.
      allow delete: if hasPerm('deleteMembers');

      // Update: owners can change anything. Staff get a few narrow
      // carve-outs, each tied to a specific granted permission, on top of
      // the always-available Approve carve-out:
      //  - Approve (false -> true) needs no permission — every staff login
      //    can do this, same as before.
      //  - Freeze / Resume needs `editMemberDetails`.
      //  - Mark as Paid needs `payments`.
      //  - Renew Plan changes plan/expiry AND payment status/dues together,
      //    so it needs BOTH `editMemberDetails` and `payments`.
      //  - Cancel & Refund needs `refunds`.
      // Any field outside these named sets (phone-number-change migration,
      // anything else) still requires isOwnerAdmin() — phone change in
      // particular rewrites the doc under a new ID with a wide field copy,
      // which is too broad to safely carve out per-field, so it stays
      // owner-only regardless of the permissions map.
      // The public self-checkin kiosk (member.js, no auth) separately gets
      // its own narrow carve-out to bump its OWN doc's monthly check-in
      // counter after a successful checkin — a harmless display stat, not
      // a trust boundary.
      allow update: if isOwnerAdmin()
        ||
        (isVerifiedAdminDirect()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'updatedAt'])
          && resource.data.approved == false
          && request.resource.data.approved == true)
        ||
        (hasPerm('editMemberDetails')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isFrozen', 'freezeStartDate', 'totalFrozenDays', 'expiryDate', 'updatedAt']))
        ||
        (hasPerm('payments')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['paymentStatus', 'updatedAt']))
        ||
        // Approving an unpaid day-pass member and collecting payment in the
        // same step (see admin.js executeApproveMember's collectPaymentToo)
        // combines the Approve carve-out's field with payment fields in one
        // write, so it needs its own branch rather than fitting either one
        // above — same false->true approve guard as the plain Approve
        // carve-out, plus `payments`.
        (hasPerm('payments')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['approved', 'paymentStatus', 'duesAmount', 'updatedAt'])
          && resource.data.approved == false
          && request.resource.data.approved == true)
        ||
        (hasPerm('editMemberDetails') && hasPerm('payments')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['plan', 'expiryDate', 'paymentStatus', 'duesAmount', 'updatedAt']))
        ||
        (hasPerm('refunds')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['expiryDate', 'cancelledAt', 'updatedAt']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['monthlyCheckinCount', 'checkinMonthKey'])
          && request.resource.data.monthlyCheckinCount is int
          && request.resource.data.monthlyCheckinCount >= 0
          && request.resource.data.checkinMonthKey is string);
    }

    // Checkins collection: Prevent fake check-ins from unapproved members.
    // `get` is public (same pattern as members/{phone} below) because
    // members aren't signed in — the kiosk app needs to fetch a specific
    // check-in doc by its deterministic ID (`${memberId}_${dateKey}`) to
    // show "already checked in today" and the last-7-days history, and
    // there's no auth session to scope a broader query to. `list` stays
    // admin-only so nobody can enumerate every check-in (and thus every
    // memberId) across the whole gym.
    match /checkins/{checkinId} {
  allow create: if request.resource.data.memberId is string
                && request.resource.data.phone is string
                && request.resource.data.phone.size() >= 7
                && request.resource.data.dateKey is string
                && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') //  Yeh format check add karein
                && request.resource.data.method in ["geofenced-gps", "manual"]
                && request.resource.data.timestamp == request.time
                && checkinId == request.resource.data.memberId + '_' + request.resource.data.dateKey
                && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.approved == true
                // Frozen/paused members can't check in until an admin resumes
                // their membership (see admin.js executeFreezeMember/Resume).
                && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get('isFrozen', false) != true;
                
  allow get: if true;
  allow list: if isVerifiedAdminDirect();
  allow update, delete: if isVerifiedAdminDirect();
}

    
    // Payments collection: financial records. Owner, or staff granted the
    // `payments` permission, can log a new payment and read payment/
    // revenue history. Editing or deleting an existing payment record stays
    // owner-only (the client never does this — it's an accountability log).
    match /payments/{paymentId} {
      allow create, read: if hasPerm('payments');
      allow update, delete: if isOwnerAdmin();
    }

    // Refunds collection: same pattern as payments above — owner, or staff
    // granted `refunds`, can log/read refunds; editing or deleting a past
    // refund record stays owner-only (also unused by the client).
    match /refunds/{refundId} {
      allow create, read: if hasPerm('refunds');
      allow update, delete: if isOwnerAdmin();
    }

    // Settings collection: Public read (UPI config, gym config/plans),
    // admin-only write. `gymConfig` gets an extra shape check purely for
    // data-integrity — every page's plan picker and pricing display reads
    // this doc, so a malformed write (already gated to admins-only; this
    // isn't a new trust boundary) shouldn't be able to break the app for
    // every member at once.
        // Settings collection rules update:
    match /settings/{docId} {
      function isValidGymConfig() {
        return request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.defaultCountryCode is string
              && request.resource.data.plans is map
              && request.resource.data.plans.size() > 0;
      }

      // Feature-tier doc (Basic/Prime/Advance) — controls which optional
      // modules (WhatsApp bot, future features) are unlocked for this gym.
      function isValidTierConfig() {
        return request.resource.data.current in ['basic', 'prime', 'advance'];
      }

      allow get: if true;
      allow list: if isVerifiedAdminDirect();
      // Changing gym config / pricing / tier: owner, or staff granted
      // `manageSettings` — every staff login can still READ it (needed to
      // render the dashboard) regardless. Deleting a settings doc stays
      // owner-only (also unused by the client — extra safety net).
      allow create, update: if hasPerm('manageSettings')
                            && (docId != 'gymConfig' || isValidGymConfig())
                            && (docId != 'tier' || isValidTierConfig());
      allow delete: if isOwnerAdmin();
    }


    // Admins collection: Locked down, with two narrow owner-only exceptions
    // added for in-app staff management (Staff Access modal in admin.js).
    // A signed-in user may still read ONLY their own doc ID directly (the
    // isVerifiedAdmin() lookup). List is now allowed for the owner alone,
    // so the Staff Access modal can show the current staff list without
    // opening list access to staff or the public.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow list: if isOwnerAdmin();

      // Owner can grant staff access — but ONLY as role "staff", never
      // "owner", and only as a brand-new doc: `create` in Firestore rules
      // matches solely when no document already exists at this path, so
      // this can never silently overwrite (and thus never downgrade) an
      // existing owner's or staff member's doc. `permissions` must be a
      // full, valid map (see isValidPermissionsMap) — admin.js always
      // creates a new staff login with every permission explicitly false,
      // which the owner then turns on individually from Edit Permissions.
      // Nothing else may be set on this doc from the client.
      allow create: if isOwnerAdmin()
        && request.resource.data.role == 'staff'
        && request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt', 'permissions'])
        && isValidPermissionsMap(request.resource.data.permissions);

      // Owner can revoke access — but only ever a staff doc, never an
      // owner's own or another owner's doc, so this can't be used (by
      // mistake or otherwise) to lock an owner out via the app.
      allow delete: if isOwnerAdmin() && resource.data.role == 'staff';

      // Owner can edit an EXISTING staff login's `permissions` map (the
      // Edit Permissions modal in the Staff Access panel) — this is the
      // only field an update may ever touch, `role` can never be changed
      // in place (granting/revoking owner access always goes through
      // create/delete above, never update), and the target must already be
      // a staff doc, never the owner's own.
      allow update: if isOwnerAdmin()
        && resource.data.role == 'staff'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions', 'updatedAt'])
        && isValidPermissionsMap(request.resource.data.permissions);
    }
  }
}
